// Griffin Construction - Prisma Schema with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED
  ON_HOLD
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  RESOLVED
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  fullName     String
  role         Role          @default(ADMIN)
  phone        String?
  avatar       String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Project {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  category         String        // Residential, Commercial, Industrial, Infrastructure
  location         String
  clientName       String?
  status           ProjectStatus @default(ONGOING)
  startDate        DateTime?
  completionDate   DateTime?
  shortDescription String
  fullDescription  String?       @db.Text
  coverImage       String
  gallery          Json?         @default("[]") // Array of image URLs
  displayOrder     Int           @default(0)
  featured         Boolean       @default(false)
  published        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([featured])
  @@index([published])
  @@map("projects")
}

model Service {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  category         String   // Commercial, Industrial, Infrastructure, Residential
  shortDescription String
  fullDescription  String?  @db.Text
  icon             String?  // Lucide icon name e.g. "Home", "Building2", "Truck"
  cardImage        String?
  heroImage        String?
  overviewImage    String?
  keyFeatures      Json?    @default("[]") // Array of string features
  displayOrder     Int      @default(0)
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([published])
  @@map("services")
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.Text
  author          String    @default("Mayank Goyal")
  category        String    @default("Industry Insights")
  tags            Json?     @default("[]") // Array of string tags
  featuredImage   String?
  readingTime     Int       @default(5)
  featured        Boolean   @default(false)
  published       Boolean   @default(true)
  publicationDate DateTime? @default(now())
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([featured])
  @@index([published])
  @@map("blog_posts")
}

model ContactInquiry {
  id          String        @id @default(uuid())
  fullName    String
  email       String
  phone       String?
  subject     String
  projectType String?       // Commercial, Residential, Industrial, Infrastructure, Other
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  assignedTo  String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

model TeamMember {
  id           String   @id @default(uuid())
  fullName     String
  designation  String
  shortBio     String?  @db.Text
  photo        String?
  linkedinUrl  String?
  email        String?
  experience   String?  // e.g. "20+ Years"
  skills       Json?    @default("[]") // Array of strings
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([featured])
  @@index([published])
  @@map("team_members")
}

model WebsitePage {
  id             String   @id @default(uuid())
  slug           String   @unique // home, about, contact, privacy-policy, terms
  title          String
  pageType       String   @default("general") // home, about, contact, legal
  heading        String?
  subtitle       String?  @db.Text
  ctaText        String?
  ctaLink        String?
  seoTitle       String?
  seoDescription String?  @db.Text
  sections       Json?    @default("[]")
  stats          Json?    @default("[]")
  advantages     Json?    @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("website_pages")
}

model SiteSettings {
  id                String   @id @default("settings_global")
  companyName       String   @default("Griffin Construction")
  tagline           String?  @default("Building Tomorrow, Together.")
  phone             String?  @default("+91 123 456 7890")
  phoneDisplay      String?  @default("+91 123 456 7890")
  email             String?  @default("contact@griffinconstruction.in")
  address           String?  @default("Mohali, Punjab – 160055, India")
  workingHours      String?  @default("Mon - Sat: 9:00 AM - 7:00 PM")
  websiteUrl        String?  @default("https://griffinconstruction.in")
  headerCtaText     String?  @default("Get a Quote")
  headerCtaLink     String?  @default("/contact")
  facebook          String?
  instagram         String?
  linkedin          String?
  twitter           String?
  footerDescription String?  @db.Text
  copyrightText     String?  @default("© 2026 Griffin Construction. All rights reserved.")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}

model MediaAsset {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String
  fileType  String   @default("Image") // Image, Document, Video
  mimeType  String?
  size      Int?     // Size in bytes
  folder    String   @default("General") // Projects, Services, Team, Blog, General
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@map("media_assets")
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   // created, updated, deleted, published, received
  entityType  String   // Project, Service, BlogPost, ContactInquiry, TeamMember, SiteSettings
  entityTitle String
  userEmail   String?
  userName    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
  @@map("activity_logs")
}

