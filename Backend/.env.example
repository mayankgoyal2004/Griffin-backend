# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Replace with your actual PostgreSQL connection string:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/griffin_db?schema=public"

# Authentication & Security
JWT_SECRET="griffin_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="griffin_cookie_secret_key_2026"

